---
// One slide in a SlidesLayout deck. Speaker notes go in the "notes" slot and
// only appear in the presenter window.
interface Props {
  // Section of the deck, for reading the source; not shown.
  section?: string
  // Short name for the presenter window's "Next:" line.
  label: string
}

const { label } = Astro.props
---

<section class="slide" data-label={label}>
  <div class="slide-body">
    <slot />
  </div>
  <div class="notes"><slot name="notes" /></div>
</section>
