---
// One slide in a SlidesLayout deck. Speaker notes go in the "notes" slot and
// only appear in the presenter window.
interface Props {
  // Section of the deck, for reading the source; not shown.
  section?: string
  // Short name for the presenter window's "Next:" line.
  label: string
  // A slide about work that is not ready yet. It shows a "Planned" tag,
  // and ?final in the address hides it.
  planned?: boolean
}

const { label, planned } = Astro.props
---

<section class="slide" data-label={label} data-planned={planned ? '' : undefined}>
  <div class="slide-body">
    <slot />
  </div>
  {planned && <p class="planned-tag t-credit">Planned</p>}
  <div class="notes"><slot name="notes" /></div>
</section>
