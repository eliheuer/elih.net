---
// A figure that fills its grid cell, scaled to fit, with an optional credit
// line. `credit` is trusted HTML written in the slide source.
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  src: ImageMetadata
  alt: string
  credit?: string
  class?: string
}

const { src, alt, credit, class: className } = Astro.props
// Cap at 2400 px wide or 1600 px tall: enough for a 4K projector cell.
const width = Math.round(
  Math.min(src.width, 2400, (1600 * src.width) / src.height),
)
---

<figure class:list={['fig', className]}>
  <Image src={src} alt={alt} width={width} loading="eager" />
  {credit && <figcaption class="t-credit" set:html={credit} />}
</figure>
