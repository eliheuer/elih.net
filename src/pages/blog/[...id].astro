---
import PostHead from '@/components/PostHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts } from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getAllPosts()

  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }))
}

const post = Astro.props
const currentPostId = Astro.params.id
const { Content } = await render(post)

// Break the display title after its first colon (main: subtitle) so long
// titles wrap on the colon instead of mid-phrase. Meta title stays untouched.
const [titleMain, titleRest] = post.data.title.split(/:\s+(.*)/s)

// Per-post second break in the subtitle, where the default wrap lands
// mid-phrase. Each pattern captures the two halves to split on.
const SUBTITLE_BREAKS: Record<string, RegExp> = {
  'virtua-grotesk': /^(.*\bfor)\s+(.*)$/,
  neuraltype: /^(.*\bPost-OpenType)\s+(.*)$/,
}
const subtitleBreak = titleRest
  ? (SUBTITLE_BREAKS[currentPostId]?.exec(titleRest) ?? null)
  : null
---

<Layout>
  <PostHead slot="head" post={post} />

  <article class="pt-5 pb-8">
    <header class="mb-4">
      <h1
        class={`blog-post-title ${currentPostId === 'virtua-grotesk' ? 'leading-[0.95]' : 'leading-[1.05]'} tracking-[-0.025em] text-balance font-semibold`}
      >
        {
          titleRest ? (
            <>
              {titleMain}:<br />
              {subtitleBreak ? (
                <>
                  {subtitleBreak[1]}
                  <br />
                  {subtitleBreak[2]}
                </>
              ) : (
                titleRest
              )}
            </>
          ) : (
            post.data.title
          )
        }
      </h1>
      <p class="text-muted-foreground mt-1.5">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        {post.data.dateNote && <span> · {post.data.dateNote}</span>}
      </p>
    </header>

    <div
      class={`prose ${currentPostId === 'virtua-grotesk' ? 'tight-headings' : ''}`}
    >
      <Content />
    </div>
  </article>
</Layout>
