  <Slide section="Hardware" label="Memory size">
    <div class="sw">
      <div class="sw-head"><p class="sw-sec">05 Hardware</p><p class="sw-talk">{TALK}</p><p class="sw-num"></p></div>
      <h2 class="sw-title t-display">Memory size</h2>
      <div class="sw-body">
        <p class="sw-lead t-head">The model must fit in memory.</p>
        <ol class="sw-points">
          <li>qwen3.5-4b<span class="val">2.9 GB</span></li>
          <li>gpt-oss-20b<span class="val">12.1 GB</span></li>
          <li>qwen3.6-27b<span class="val">17.6 GB</span></li>
