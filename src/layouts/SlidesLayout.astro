---
// Full-screen 16:9 slide deck. Shares the site's fonts, color tokens, and
// theme with the blog, but none of its chrome. Each <Slide> is stacked in
// one stage; the script below shows one at a time.
//
// Keys: → ↓ PageDown next · ← ↑ PageUp previous · Home/End · F fullscreen
// · G grid · P presenter window · Esc leaves a focused demo.
// Inside a demo, arrows and typing go to the demo; PageUp/PageDown (what
// presentation clickers send) always change slides.
import '@/styles/global.css'
import '@/styles/typography.css'

import Head from '@/components/Head.astro'
import PageHead from '@/components/PageHead.astro'
import { SITE } from '@/consts'

interface Props {
  title: string
  description: string
  // Short label for the talk, e.g. its title; kept on the deck element.
  running: string
  author: string
}

const { title, description, running, author } = Astro.props
---

<!doctype html>
<html lang={SITE.locale} class="use-virtua-font dark">
  <Head>
    <PageHead title={title} description={description} />
    <meta name="robots" content="noindex" />
    <script is:inline>
      if (new URLSearchParams(location.search).has('presenter'))
        document.documentElement.classList.add('presenter')
    </script>
  </Head>
  <body>
    <div class="deck" data-running={running} data-author={author}>
      <div class="stage">
        <slot />
        <!-- Layout aid: press G. The 12 columns, the margins and the
             1.25cqw baseline unit, drawn over every slide. -->
        <div class="grid-overlay" aria-hidden="true">
          {Array.from({ length: 12 }, (_, i) => <span>{i + 1}</span>)}
        </div>
      </div>
    </div>

    <div class="presenter-view">
      <div class="pv-top">
        <span class="pv-count"></span>
        <span class="pv-timer">0:00</span>
      </div>
      <div class="pv-label"></div>
      <div class="pv-notes"></div>
      <div class="pv-next"></div>
      <div class="pv-help">
        → next · ← previous · R reset timer · keys here drive the deck
      </div>
    </div>
  </body>
</html>

<script>
  const slides = [...document.querySelectorAll<HTMLElement>('.slide')]
  const deck = document.querySelector<HTMLElement>('.deck')!
  const presenter = document.documentElement.classList.contains('presenter')
  const channel = new BroadcastChannel('elih-slides:' + location.pathname)
  const total = slides.length
  const pad = (n: number) => String(n).padStart(2, '0')

  const fromHash = () => {
    const n = parseInt(location.hash.slice(1), 10)
    return Number.isFinite(n) ? Math.min(Math.max(n, 1), total) - 1 : 0
  }

  let current = -1
  let timerStart: number | null = null

  function show(i: number, broadcast = true) {
    i = Math.min(Math.max(i, 0), total - 1)
    if (i === current) return
    slides[current]?.removeAttribute('data-active')
    slides[i].setAttribute('data-active', '')
    // Blur a demo on the slide we are leaving so its keys stop capturing.
    if (document.activeElement instanceof HTMLElement)
      document.activeElement.blur()
    current = i
    history.replaceState(null, '', `#${i + 1}`)
    if (broadcast) channel.postMessage({ type: 'show', index: i })
    if (timerStart === null && i > 0) timerStart = Date.now()
    renderPresenter()
  }

  function renderPresenter() {
    if (!presenter) return
    const s = slides[current]
    const next = slides[current + 1]
    document.querySelector('.pv-count')!.textContent =
      `${pad(current + 1)} / ${pad(total)}`
    document.querySelector('.pv-label')!.textContent = s.dataset.label ?? ''
    document.querySelector('.pv-notes')!.innerHTML =
      s.querySelector('.notes')?.innerHTML ?? ''
    document.querySelector('.pv-next')!.textContent = next
      ? `Next: ${next.dataset.label ?? ''}`
      : 'End'
  }

  function tick() {
    const el = document.querySelector('.pv-timer')
    if (el) {
      const s = timerStart ? Math.floor((Date.now() - timerStart) / 1000) : 0
      el.textContent = `${Math.floor(s / 60)}:${pad(s % 60)}`
    }
  }
  if (presenter) setInterval(tick, 500)

  channel.onmessage = (e) => {
    if (e.data?.type === 'show') show(e.data.index, false)
    if (e.data?.type === 'hello' && !presenter)
      channel.postMessage({ type: 'show', index: current })
  }

  // True when keystrokes belong to a demo or a form field.
  function typingTarget(t: EventTarget | null) {
    if (!(t instanceof HTMLElement)) return false
    return (
      !!t.closest('.slide-demo') ||
      t.isContentEditable ||
      ['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName)
    )
  }

  // Baselines on the grid. For each text size, measure where its
  // baseline falls in its line box and how tall its capitals are, and
  // move the text so the first baseline lands on the first grid line
  // below the cap height. Line heights are whole rows, so every later
  // baseline lands on a line too. Shifts are kept in cqw.
  {
    const stage = document.querySelector('.stage') as HTMLElement
    const width = () => stage.getBoundingClientRect().width
    const css = getComputedStyle(stage)
    const cqw = (name: string) => (parseFloat(css.getPropertyValue(name)) * width()) / 100
    const row = cqw('--u')
    const ctx = document.createElement('canvas').getContext('2d')!
    const shift = (size: string, lh: string) => {
      const box = document.createElement('div')
      box.style.cssText =
        'position:absolute;left:0;top:0;visibility:hidden;white-space:nowrap;' +
        `font-size:var(${size});line-height:var(${lh})`
      const mark = document.createElement('span')
      mark.style.cssText = 'display:inline-block;width:0;height:0;vertical-align:baseline'
      box.append('H', mark)
      stage.append(box)
      const baseline = mark.getBoundingClientRect().top - box.getBoundingClientRect().top
      ctx.font = `${cqw(size)}px ${getComputedStyle(box).fontFamily}`
      const cap = ctx.measureText('H').actualBoundingBoxAscent
      box.remove()
      const first = Math.max(1, Math.ceil(cap / row - 0.05)) * row
      return ((first - baseline) / width()) * 100
    }
    for (const [name, size, lh] of [
      ['--shift-mm', '--mm', '--mm-lh'],
      ['--shift-l', '--l', '--l-lh'],
      ['--shift-xl', '--xl', '--xl-lh'],
      ['--shift-cr', '--cr', '--cr-lh'],
    ]) {
      stage.style.setProperty(name, `${shift(size, lh).toFixed(4)}cqw`)
    }
  }

  // Layout aid: ?grid in the address shows the grid from the start.
  if (new URLSearchParams(location.search).has('grid')) {
    document.body.classList.add('show-grid')
  }

  window.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return
    if (e.key === 'PageDown') return e.preventDefault(), show(current + 1)
    if (e.key === 'PageUp') return e.preventDefault(), show(current - 1)
    if (typingTarget(e.target)) {
      if (e.key === 'Escape') (e.target as HTMLElement).blur()
      return
    }
    switch (e.key) {
      case 'ArrowRight':
      case 'ArrowDown':
        e.preventDefault()
        show(current + 1)
        break
      case 'ArrowLeft':
      case 'ArrowUp':
        e.preventDefault()
        show(current - 1)
        break
      case 'Home':
        show(0)
        break
      case 'End':
        show(total - 1)
        break
      case 'f':
        if (document.fullscreenElement) document.exitFullscreen()
        else document.documentElement.requestFullscreen()
        break
      case 'p':
        if (!presenter)
          window.open(
            location.pathname + '?presenter' + location.hash,
            'presenter',
            'width=900,height=700',
          )
        break
      case 'r':
        if (presenter) timerStart = Date.now()
        break
      case 'g':
      case 'G':
        document.body.classList.toggle('show-grid')
        break
    }
  })

  window.addEventListener('hashchange', () => show(fromHash()))

  // Hide the pointer after two idle seconds.
  let idle: number | undefined
  window.addEventListener('mousemove', () => {
    document.body.classList.remove('idle')
    clearTimeout(idle)
    idle = window.setTimeout(() => document.body.classList.add('idle'), 2000)
  })

  show(fromHash(), false)
  if (presenter) channel.postMessage({ type: 'hello' })
</script>

<style is:global>
  /* ── Stage ── */

  html,
  body {
    height: 100%;
    overflow: hidden;
  }

  body.idle {
    cursor: none;
  }

  .deck {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--background);
  }

  .stage {
    position: relative;
    width: min(100vw, calc(100vh * 16 / 9));
    aspect-ratio: 16 / 9;
    container-type: size;
    /* 1cqw is 19.2px at 1920 wide. Every size below is in cqw so the
       slide scales as one picture. */
    /* The baseline unit: 1.25cqw (24px at 1920). Three text sizes, each
       on a whole number of units: XL on six, L on three, M on two. */
    --u: 1.25cqw;
    --xl: 7cqw;
    --xl-lh: calc(6 * var(--u));
    --l: 3.75cqw;
    --l-lh: calc(3 * var(--u));
    --mm: 1.875cqw;
    --mm-lh: calc(2 * var(--u));
    /* image credits: the one smaller size, one unit per line */
    --cr: 1.25cqw;
    --cr-lh: var(--u);
    font-size: var(--mm);
    line-height: var(--mm-lh);
    color: var(--foreground);
  }

  /* ── Slide grid: 12 columns, one body ── */

  .slide {
    --m: 3.125cqw; /* outer margin, all four sides: 60px at 1920 */
    --g: 1.25cqw; /* gutter */
    position: absolute;
    inset: 0;
    padding: var(--m);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    /* Vertical rhythm: units of 1.25cqw (24px at 1920). Inside the
       margins there are exactly 40, all for the body. */
    grid-template-rows: calc(40 * var(--u));
    column-gap: var(--g);
    visibility: hidden;
  }

  .slide[data-active] {
    visibility: visible;
  }

  .slide-body {
    grid-column: 1 / -1;
    grid-row: 1;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: minmax(0, 1fr);
    min-height: 0;
  }

  .slide .notes {
    display: none;
  }

  /* ── Layout aid: the grid, toggled with G ── */

  .grid-overlay {
    position: absolute;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    padding: 3.125cqw; /* the slide's --m */
    display: none;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1.25cqw; /* the slide's --g */
    /* the baseline unit, 1.25cqw, from the top margin */
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(1.25cqw - 1px),
      rgb(0 160 255 / 0.3) calc(1.25cqw - 1px),
      rgb(0 160 255 / 0.3) 1.25cqw
    );
    background-position: 0 3.125cqw;
    outline: 1px solid rgb(255 0 128 / 0.6);
    outline-offset: -3.125cqw;
  }

  body.show-grid .grid-overlay {
    display: grid;
  }

  .grid-overlay span {
    background: rgb(255 0 128 / 0.04);
    border-left: 1px solid rgb(255 0 128 / 0.35);
    border-right: 1px solid rgb(255 0 128 / 0.35);
    font: 0.75cqw / 1 var(--font-mono);
    color: rgb(255 0 128 / 0.8);
    padding: 0.3cqw;
  }

  /* ── Type ── */

  .slide :is(h1, h2, h3, p) {
    margin: 0;
    text-wrap: pretty;
  }

  .t-display {
    font-size: var(--xl);
    line-height: var(--xl-lh);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .t-head {
    font-size: var(--l);
    line-height: var(--l-lh);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  /* body, small and credit text are all M */
  .t-body,
  .t-small {
    font-size: var(--mm);
    line-height: var(--mm-lh);
  }

  /* credits are the one smaller size: mono, one unit per line */
  .t-credit {
    font-family: var(--font-mono);
    font-size: var(--cr);
    line-height: var(--cr-lh);
    color: oklch(0.55 0 0);
  }

  .t-credit a {
    color: inherit;
  }

  .t-num {
    font-size: var(--xl);
    line-height: var(--xl-lh);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  /* Size alone carries the hierarchy: muted text keeps the full color. */
  .muted {
    color: inherit;
  }

  /* gaps are whole units */
  .stack > * + * {
    margin-top: var(--mm-lh) !important;
  }
  .stack-lg > * + * {
    margin-top: calc(2 * var(--mm-lh)) !important;
  }

  /* Baselines on the grid lines: each size moves its text down so the
     baseline of every line sits on the line at the bottom of its row.
     The shifts are measured from the font when the deck loads. */
  .slide :where(p, h1, h2, h3, li, td, th, figcaption) {
    position: relative;
    top: var(--shift-mm, 0);
  }
  .slide :where(.t-display, .t-num) {
    top: var(--shift-xl, 0);
  }
  .slide :where(.t-head) {
    top: var(--shift-l, 0);
  }
  .slide :where(.t-credit) {
    top: var(--shift-cr, 0);
  }

  /* ── Column spans ── */

  .c-1-4 { grid-column: 1 / 5; }
  .c-1-5 { grid-column: 1 / 6; }
  .c-1-6 { grid-column: 1 / 7; }
  .c-1-7 { grid-column: 1 / 8; }
  .c-1-8 { grid-column: 1 / 9; }
  .c-1-9 { grid-column: 1 / 10; }
  .c-1-10 { grid-column: 1 / 11; }
  .c-1-12 { grid-column: 1 / 13; }
  .c-5-12 { grid-column: 5 / 13; }
  .c-6-12 { grid-column: 6 / 13; }
  .c-7-12 { grid-column: 7 / 13; }
  .c-4-12 { grid-column: 4 / 13; }

  .row-end {
    align-self: end;
  }

  /* ── Figures ── */

  .fig {
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fig img {
    display: block;
    min-height: 0;
    flex: 1 1 auto;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left top;
  }

  .fig.fig-right img {
    object-position: right top;
  }

  .fig.fig-right figcaption {
    text-align: right;
  }

  /* one unit of space between an image and its credit */
  .fig figcaption {
    padding-top: var(--u);
  }

  .fig.fig-center img {
    object-position: center top;
  }

  .fig.fig-center figcaption {
    text-align: center;
  }

  /* A photograph that fills the whole slide, over the margins and the
     footer. */
  .slide .bleed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  /* Text over a full-bleed image: a box of the ground color behind each
     block, trimmed to the text itself (cap height at the top, the
     baseline at the bottom) with one unit of padding on every side.
     The boxes, not the letters, sit on the margins. */
  .over-bleed {
    position: relative;
    z-index: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--u);
  }
  .over-bleed > * {
    background: var(--background);
    padding: var(--u);
    text-box: trim-both cap alphabetic;
    /* boxes are placed by the margins, not by the baseline grid */
    top: 0 !important;
    margin: 0 !important;
  }
  /* a block with descenders: trimmed at the baseline like the rest, and
     its bottom padding a little deeper than them (0.26em), so the bottom
     edge stays as close to one unit as the other three */
  .over-bleed > .descends {
    padding-bottom: max(var(--u), 0.26em);
  }
  .over-bleed.at-bottom {
    align-self: end;
  }

  .quote {
    margin: 0;
  }

  /* Two images stacked, each centered on the full width:
     a close look at the same lines set two ways. */
  .zoom-pair {
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    row-gap: var(--u);
    min-height: 0;
  }
  .zoom-pair > .fig {
    grid-column: 1 / 13;
  }

  /* ── Tables ── */

  .slide table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--mm);
    line-height: var(--mm-lh);
  }

  .slide th {
    text-align: left;
    font-weight: 400;
    color: color-mix(in oklab, var(--foreground) 55%, var(--background));
    padding: 0 1cqw 0 0;
    box-shadow: inset 0 -1px 0 var(--foreground);
  }

  .slide td {
    padding: 0 1cqw 0 0;
    box-shadow: inset 0 -1px 0 var(--border);
    vertical-align: top;
  }

  .slide td.num,
  .slide th.num {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  /* ── Demos: the React islands keep their own 3:2 / 6:5 shape, so the
     wrapper caps width by the height available on the slide. ── */

  .slide-demo {
    min-height: 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .slide-demo.ratio-3-2 {
    width: min(100%, calc((100cqh - 3.75cqw * 2 - 5cqw) * 1.5));
  }

  .slide-demo.ratio-6-5 {
    width: min(100%, calc((100cqh - 3.75cqw * 2 - 5cqw) * 1.2));
  }

  /* ── Presenter window ── */

  .presenter-view {
    display: none;
  }

  html.presenter .deck {
    display: none;
  }

  html.presenter .presenter-view {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
    padding: 1.5rem 2rem;
    background: var(--background);
    color: var(--foreground);
    overflow: auto;
  }

  .pv-top {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    border-top: 1px solid var(--foreground);
    padding-top: 0.5rem;
  }

  .pv-timer {
    font-size: 2rem;
    line-height: 1;
  }

  .pv-label {
    font-size: 1.5rem;
    line-height: 1.1;
  }

  .pv-notes {
    flex: 1;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .pv-notes p + p,
  .pv-notes ul {
    margin-top: 0.75rem;
  }

  .pv-notes ul {
    list-style: disc;
    padding-left: 1.25rem;
  }

  .pv-next,
  .pv-help {
    color: color-mix(in oklab, var(--foreground) 55%, var(--background));
  }

  .pv-help {
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }
</style>
